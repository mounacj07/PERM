# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Generated telemetry / traffic data (regenerated by running the system) ---
telemetry_log.csv
telemetry_log.csv.bak
phase_log.csv
controller_events.csv
controller_state.json
controller_status.json

# If you want to commit a specific "final" dataset snapshot for reproducibility,
# rename it (e.g. telemetry_log_final.csv) and it won't be ignored by the rule above.

# --- Large generated CSVs ---
features_train.csv
features_val.csv
features_test.csv
step1_scaling_proof.csv
testbed_calibration.json

# --- Trained model artifacts (regenerated via train_model.py) ---
models/*.joblib
models/*.pkl

# Same idea: commit a deliberately renamed final model if needed, e.g.
# models/rf_model_final.joblib

# --- IDE / editor ---
.vscode/
.idea/
*.swp

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Logs and agent outputs ---
*.log
logs/
.system_generated/
scratch/
brain/
agent_output/
server.log
locust.log

# --- SQLite database (regenerated by the running system) ---
*.db
*.db-wal
*.db-shm

# --- Large zip archives ---
*.zip
*.zip.zip